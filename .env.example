# ==============================================================================
# Datastraw CX Copilot — Environment Configuration
# Copy this file to .env before starting the development server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Gateway / LLM Providers (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Primary Google Gemini API key (Used by api/gemini.js and local server.cjs)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API key for multi-model fallback (Claude, Llama-3, DeepSeek)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 2. Database & Multi-Tenant Backend (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase project URL and anonymous public key (protected by Row-Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Service role key for admin tasks / migrations (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Application Runtime & Mock Mode
# ------------------------------------------------------------------------------
# When 'true', deterministic grounded mock mode is enabled as an automatic fallback
# ensuring the app works out-of-the-box even without active API credentials
VITE_ENABLE_MOCK_FALLBACK=true

# Local server port for server.cjs
PORT=3000
