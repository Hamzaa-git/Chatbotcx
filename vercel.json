{
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/gemini/:path*",
      "destination": "/api/gemini?path=:path*"
    },
    {
      "source": "/api/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
